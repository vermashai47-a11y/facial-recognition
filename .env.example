# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses RLS — never expose it to the browser, never prefix it
# with NEXT_PUBLIC_. Used solely by the nightly cron route.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Cron authentication. Generate with:  openssl rand -hex 32
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional. Set to "true" AND run `npm run fetch:models -- --full` to enable the
# WebGPU execution provider (~3x faster inference, +28 MB of static assets —
# which exceeds Vercel Hobby's 100 MB upload cap, so this suits self-hosting
# or a paid plan).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEBGPU=false
