# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses RLS — never expose it to the browser, never prefix it
# with NEXT_PUBLIC_. Used solely by the nightly cron route.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Cron authentication. Generate with:  openssl rand -hex 32
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# WebGPU is NOT a runtime flag. The app imports onnxruntime-web/wasm, which
# ships a single ~14 MB runtime. Running on WebGPU means changing that import
# to 'onnxruntime-web/webgpu' in src/lib/face/embedder.ts AND running
# `npm run fetch:models -- --full` (+28 MB) — which exceeds Vercel Hobby's
# 100 MB static-upload cap, so it suits self-hosting or a paid plan.
# ---------------------------------------------------------------------------
